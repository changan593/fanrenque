    {
      "seq": 120,
      "quote": "穿了套绿色的长袍，冷着一张脸，手里捻着一粒棋子"
    },
    {
      "seq": 227,
      "quote": "墨绿长裙的下摆像是起舞的蝴蝶"
    },
    {
      "seq": 235,
      "quote": "墨绿色的长裙披散，长眉如山，垂着眼凝着眉"
    },
    {
      "seq": 236,
      "quote": "墨绿色长裙的女孩"
    },
    {
      "seq": 236,
      "quote": "长眉如山"
    },
    {
      "seq": 237,
      "quote": "远山一样的眉毛微微下垂"
    },
    {
      "seq": 241,
      "quote": "颈弧有青瓶模样，手白胜玉璧佛珍。"
    },
    {
      "seq": 241,
      "quote": "眉如远山无需黛，眼似镜湖有清波。"
    },
    {
      "seq": 241,
      "quote": "站姿秀美略小巧，坐姿安静多气魄。"
    },
    {
      "seq": 241,
      "quote": "万千黑丝齐盘脑后，白玉独钗不见雕琢。"
    },
    {
      "seq": 241,
      "quote": "是女子佳人常爱慕，乃棋坛圣手也蹉跎。"
    },
    {
      "seq": 252,
      "quote": "本来无妆的她，此时嘴唇红的鲜艳，像是抿了胭脂"
    },
    {
      "seq": 259,
      "quote": "墨绿色长裙的吴慢慢，她也很沉默，只是盯着手中捻住的一根枯黄的茅草"
    },
    {
      "seq": 266,
      "quote": "墨绿长裙没有回头。"
    },
    {
      "seq": 266,
      "quote": "一个穿着墨绿长裙的姑娘面无表情的提着一个到她腰那么高的石头棋盘"
    },
    {
      "seq": 268,
      "quote": "淡色的唇抿起白嫩的皮肤，隐隐可见手背上青色细密的血管"
    },
    {
      "seq": 274,
      "quote": "她的坐姿十分讲究，后背挺直，脖颈修长，双手平放膝上，微微低头垂目看着棋盘一动不动，只有行棋时，才会抬起胳膊优雅的落子。"
    },
    {
      "seq": 277,
      "quote": "吴慢慢坐在那，双手乖巧的摆在膝上，脖颈笔直，发丝都不会摇晃。"
    },
    {
      "seq": 302,
      "quote": "绿是来自于她裙摆的颜色，而光照则来自于她眉间的明艳。"
    },
    {
      "seq": 443,
      "quote": "墨绿长裙的女子"
    },
    {
      "seq": 443,
      "quote": "耷拉着眼睛，有些困倦"
    },
    {
      "seq": 448,
      "quote": "面带困意穿着墨绿色长裙"
    },
    {
      "seq": 464,
      "quote": "坐在假山后一个岩石上，正在无声的翻看棋谱"
    },
    {
      "seq": 482,
      "quote": "吴慢慢周身隐隐青绿，脚踩黑白两色，看起来沉静无比。"
    },
    {
      "seq": 487,
      "quote": "这位一直安静的女孩正在轻咬手背，身后发丝轻舞，双眼一黑一白无声的溢散出光点"
    },
    {
      "seq": 506,
      "quote": "吴慢慢长得端庄，大多数时候行为也端庄严肃，会给人很大的压迫感。"
    },
    {
      "seq": 516,
      "quote": "女孩依然安静端庄，其实与皇宫家宴上那只嘴里塞满了果子的松鼠并无什么区别"
    },
    {
      "seq": 516,
      "quote": "绿裙的女子面无表情的接过"
    },
    {
      "seq": 522,
      "quote": "墨绿长裙，洁白腕。素额朝天，青丝暖。"
    },
    {
      "seq": 598,
      "quote": "墨绿长裙的女子"
    },
    {
      "seq": 625,
      "quote": "她垂下眼开始翻看桌上的简报"
    },
    {
      "seq": 625,
      "quote": "女子眼眉不眨的静立，就像是一棵白桑"
    },
    {
      "seq": 625,
      "quote": "从袖子里拿出手绢擦拭了一下鼻前，点点鲜红很是扎眼"
    },
    {
      "seq": 655,
      "quote": "那身墨绿色的长裙"
    },
    {
      "seq": 896,
      "quote": "她坐在棋盘上，神情平静的像是坐在棋盘山的那个她常坐的木椅上"
    },
    {
      "seq": 896,
      "quote": "吴慢慢瘦弱的身躯直接砸向地面"
    },
    {
      "seq": 896,
      "quote": "她就像是一只绿色的落地的风筝一下子安静且颇为滑稽的趴在了那里"
    },
    {
      "seq": 896,
      "quote": "吴慢慢的眼神冷冷的"
    },
    {
      "seq": 899,
      "quote": "照亮了吴慢慢的脸，也照亮了她嘴角溢出的血，那张脸上除了血还有一种情绪"
    },
    {
      "seq": 919,
      "quote": "神色平静，但眼神却闪烁着绿色的灵光"
    },
    {
      "seq": 920,
      "quote": "她撸起袖子，将白藕一般的手臂插入了淤泥中"
    },
    {
      "seq": 1009,
      "quote": "一个文静而美丽女孩正安静的坐在那，她明明只是简单的坐着，却好像天生与那里契合一般，椅子、桌子与风都与她勾连。"
    },
    {
      "seq": 1174,
      "quote": "一个墨绿长裙的女子安静的走过，她淡淡的看了他一眼"
    },
    {
      "seq": 1175,
      "quote": "墨绿色的长裙格外的显眼，好像一棵树生在了沙漠中。"
    }
