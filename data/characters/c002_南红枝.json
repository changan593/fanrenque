    {
      "seq": 6,
      "state": "被封印于洞天，从小受严格教育的传统乖乖女，很听唐真的话"
    },
    {
      "seq": 7,
      "state": "十六岁，伴生灵宝十二面琉璃灯的持有者，被正魔两道视作祸端"
    },
    {
      "seq": 8,
      "state": "面对死亡远比唐真从容，最终因伴生灵宝被毁而神魂俱散"
    }
