# 运行期产物：日志、缓存
.run/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 密钥绝不入库（API key 一律走环境变量 DEEPSEEK_API_KEY / IMAGE_API_KEY）
.env
*.key

# 画风选型的出图与拼图产物：330 张 2K 图 + 22 张大图，几百 MB，
# 且随时能由 matrix.json 重新生成。
# 入库的是 matrix.json、prompts.md 和 refs/（参考片截图，人工采集，重跑不出来）
production/style_test/out/
production/style_test/sheets/

# 镜头成品图：第一季 12,958 镜、一镜 2~3 版，50GB 以上，
# 且由「角色卡 + 场景卡 + 幕提示词 + 风格段」确定地推导得出。
# 入库的是每集的「出图台账.md」——用了哪一版、谁验收的，那才是删了就没的东西。
# 规范见 doc/13_出图工序规范.md 第一节。
production/s01/*/*/frames/

# 系统
.DS_Store
