# 复制成 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。真实环境变量优先级高于 .env。

# ---- 必填 ----
DEEPSEEK_API_KEY=sk-在这里填你的密钥

# ---- 可选，不填就用默认值 ----
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 并发章节数。调大跑得快，但要看你的 API 速率限制
PIPELINE_WORKERS=4

# 全局限速（每秒请求数），0 = 不限速。撞到 429 就把它调成 3~5
PIPELINE_QPS=0

# 每章质量不达标时的修订轮上限，0 = 关闭修订只跑三次调用
PIPELINE_REPAIR_ROUNDS=1

# 流式接收。开着才能实时看到「已收多少字」，关掉就只能干等（不建议关）
LLM_STREAM=1

# 强制 JSON 输出模式。个别模型不支持会返回空回复，那种情况设成 0
LLM_JSON_MODE=1

# 思考模式（思维链）。**保持 0**。
# DeepSeek 官方默认是「开、effort=high」，但逐章分析是照原文抄成结构化 JSON 的
# 抽取活，不是推理题。开着它有三个坏处：思维链和正式回复抢 max_tokens（长章节
# 直接把 content 挤成空）、官方已载明 JSON 模式本身就有概率返回空 content（两者
# 叠加时空回复率极高）、思考模式下 temperature 不生效。
# 只有想让模型对某个环节多想时才临时开，比如 --phase review。
LLM_THINKING=0
LLM_REASONING_EFFORT=high    # 仅在 LLM_THINKING=1 时发送。low / high / max

# 超时与重试
LLM_CONNECT_TIMEOUT=20    # 建连超时
LLM_STALL_TIMEOUT=90      # 流式下多久没收到新数据判定卡死并重试
LLM_TIMEOUT=600           # 单次请求总时限
LLM_MAX_RETRIES=5
# 单次输出额度。它是上限不是预扣，按实际生成量计费，给足不额外花钱。
# 被 finish_reason=length 截断时脚本会自动上调，直到 CAP 为止
LLM_MAX_TOKENS=16384
LLM_MAX_TOKENS_CAP=65536

# ---- 出图 API（按 OpenAI 官方 Images API 规范对接）----
# 只有跑 s6_style_matrix.py 画风选型时才用得上。
# base_url 指向哪个网关都行，只要它兼容 OpenAI Images API。
IMAGE_API_KEY=sk-在这里填你的画图密钥
IMAGE_BASE_URL=https://api.openai.com/v1   # 末尾不要加斜杠
IMAGE_MODEL=gpt-image-1

# 尺寸——最容易踩的一格：
#   gpt-image-*  只认 1024x1024 / 1536x1024 / 1024x1536 / auto
#   dall-e-3     才认 1792x1024 / 1024x1792
# 拿 1792x1024 配 gpt-image 会被上游拒掉，网关多半包成 502「Upstream network
# error」，看着像网络故障。脚本会在发请求前自查并说清楚。
IMAGE_SIZE=1536x1024
# 出图后居中裁成精确 16:9。接口给不出 16:9 的档位，出完自己裁最干净
IMAGE_CROP_169=1

# gpt-image 的官方可选参数。留空则不发；网关不认会 400，脚本自动摘掉重试
IMAGE_QUALITY=high        # low / medium / high / auto
IMAGE_MODERATION=low      # low / auto。我们的提示词里全是「缺牙」「丑陋」
                          # 「肮脏」「乞丐」，默认档容易误伤
IMAGE_OUTPUT_FORMAT=      # png / jpeg / webp
IMAGE_BACKGROUND=         # transparent / opaque / auto

IMAGE_WORKERS=3           # 并发格数
IMAGE_BATCH=3             # 单次请求出几张（dall-e-3 只能 1）
IMAGE_TIMEOUT=300         # 出图比出文慢，给足
IMAGE_MAX_RETRIES=5
IMAGE_RETRY_BASE=4        # 退避基数，4/8/16/32 秒共约 1 分钟
