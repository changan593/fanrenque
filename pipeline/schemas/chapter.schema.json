{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "章节分析 JSON",
  "description": "data/chapters/chXXXX.json 的结构约定。一章一个文件，seq 为唯一主键。由 s2（模型）或 s2m（人工稿）写出，s5 可就地修补。程序校验在 s3，本文件是字段口径的说明书，不做运行时校验。",
  "type": "object",
  "required": ["schema_version", "seq", "chapter_id", "declared_num", "title", "label",
               "merged_titles", "is_merged", "source",
               "raw_text", "paragraphs", "analysis", "quality", "reviews", "run"],
  "properties": {
    "schema_version": {"type": "string"},
    "seq": {"type": "integer", "minimum": 1, "description": "文件顺序号，唯一主键"},
    "chapter_id": {"type": "string", "pattern": "^ch[0-9]{4}$"},
    "declared_num": {"type": "integer", "description": "作者标注的章号，存在重号/跳号，不可当主键"},
    "title": {"type": "string"},
    "label": {"type": "string", "description": "人读章节名，合并单元含被并入的标题"},
    "merged_titles": {
      "type": "array",
      "description": "原站点把多章合并在一页时，被并入本单元的其他章节标题",
      "items": {
        "type": "object",
        "required": ["declared_num", "title"],
        "properties": {"declared_num": {"type": "integer"}, "title": {"type": "string"}}
      }
    },
    "is_merged": {"type": "boolean"},
    "source": {
      "type": "object",
      "required": ["line_start", "line_end", "char_count", "paragraph_count"],
      "properties": {
        "line_start": {"type": "integer"},
        "line_end": {"type": "integer"},
        "char_count": {"type": "integer", "description": "正文字数（不含空白）。s9/s10 的时长估算以它为准"},
        "paragraph_count": {"type": "integer"}
      }
    },
    "raw_text": {"type": "string", "description": "章节原文全文。故意冗余：章节 json 是分析时刻的完整快照，不依赖 novel.json 还在"},
    "paragraphs": {"type": "array", "items": {"type": "string"},
                   "description": "分段原文。全项目段号一律 1 基：模型看到的 [n]、这里的 para、s8 卷宗、取证文档里的 seqN[i] 都指这个数组的第 n 项（下标 n-1）"},

    "analysis": {
      "type": "object",
      "required": ["synopsis", "characters", "scenes", "dialogues", "monologues",
                   "narration", "beats"],
      "properties": {
        "one_line": {"type": "string"},
        "synopsis": {"type": "string", "description": "章节剧情简介，≥ config.SYNOPSIS_MIN_CHARS 字且以句读收尾"},
        "time_setting": {"type": "string"},
        "emotional_tone": {"type": "string"},
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role_in_chapter"],
            "properties": {
              "name": {"type": "string"},
              "aliases": {"type": "array", "items": {"type": "string"}},
              "role_in_chapter": {"type": "string",
                                  "description": "建议值：主导 / 参与 / 提及。模型不严格守枚举，s3 只统计偏离不判错"},
              "mentioned_only": {"type": "boolean"},
              "appearance_quotes": {"type": "array", "items": {"type": "string"},
                                    "description": "原文对该人物外貌/服饰的描写，必须逐字"},
              "state": {"type": "string"},
              "actions": {"type": "array", "items": {"type": "string"}},
              "_filled": {"type": "boolean", "description": "s5 按原文补登的人物（说话人不在名单里）"}
            }
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string", "description": "建议值：室内 / 室外 / 幻境梦境 / 秘境 / 其他"},
              "time_of_day": {"type": "string"},
              "description_quotes": {"type": "array", "items": {"type": "string"},
                                     "description": "原文场景描写，必须逐字"},
              "present_characters": {"type": "array", "items": {"type": "string"}},
              "events": {"type": "array", "items": {"type": "string"}},
              "para_range": {"type": "array", "items": {"type": "integer", "minimum": 1},
                             "minItems": 2, "maxItems": 2}
            }
          }
        },
        "dialogues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["para", "speaker", "text"],
            "properties": {
              "para": {"type": "integer", "minimum": 1},
              "speaker": {"type": "string"},
              "addressee": {"type": "string"},
              "text": {"type": "string", "description": "台词原文，必须逐字"},
              "manner": {"type": "string"},
              "_filled": {"type": "boolean", "description": "s5 按原文补进来的漏抽台词，speaker 待人核"}
            }
          }
        },
        "monologues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["para", "character", "text"],
            "properties": {
              "para": {"type": "integer", "minimum": 1},
              "character": {"type": "string"},
              "text": {"type": "string", "description": "心理活动原文，必须逐字"},
              "kind": {"type": "string", "description": "建议值：心理活动 / 回忆 / 判断推理 / 情绪感受"}
            }
          }
        },
        "narration": {
          "type": "array",
          "description": "关键旁白。只收有信息量的叙述句，不是全文转写",
          "items": {
            "type": "object",
            "required": ["para", "text"],
            "properties": {
              "para": {"type": "integer", "minimum": 1},
              "text": {"type": "string", "description": "旁白原文，必须逐字"},
              "function": {"type": "string",
                           "description": "建议值：世界观设定 / 人物背景 / 时间推移 / 伏笔 / 情节交代 / 环境渲染。实测全书出现过 112 种写法，故不做枚举"}
            }
          }
        },
        "beats": {
          "type": "array",
          "description": "分镜用的事件节拍，覆盖全章不留空档",
          "items": {
            "type": "object",
            "required": ["order", "summary"],
            "properties": {
              "order": {"type": "integer"},
              "para_range": {"type": "array", "items": {"type": "integer", "minimum": 1},
                             "minItems": 2, "maxItems": 2},
              "scene": {"type": "string"},
              "beat_type": {"type": "string", "description": "建议值：铺垫 / 冲突 / 转折 / 情绪 / 揭示 / 收束"},
              "summary": {"type": "string"}
            }
          }
        },
        "props": {"type": "array", "items": {"type": "object"}},
        "terms": {"type": "array", "items": {"type": "object"}},
        "continuity": {
          "type": "object",
          "properties": {
            "inherits": {"type": "array", "items": {"type": "string"}},
            "foreshadows": {"type": "array", "items": {"type": "string"}},
            "reveals": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },

    "quality": {
      "type": "object",
      "description": "质量块。verbatim / coverage / passed / fail_reasons 由 common/quality.refresh 按当前 analysis 重算，谁改了 analysis 都要调它",
      "required": ["passed", "fail_reasons", "structure_score", "fidelity_score", "verbatim", "coverage"],
      "properties": {
        "passed": {"type": "boolean", "description": "闸门结论，判据见 common/quality.gate"},
        "fail_reasons": {"type": "array", "items": {"type": "string"}},
        "structure_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100,
                            "description": "人工稿（run.model == 人工）为 null"},
        "fidelity_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "verbatim": {
          "type": "object",
          "description": "程序逐字核验：把每条引用回原文做精确匹配的客观结果",
          "properties": {
            "total_quotes": {"type": "integer"},
            "counts": {"type": "object", "description": "exact / near / miss / empty 各多少条"},
            "verbatim_rate": {"type": "number"},
            "misplaced_para_count": {"type": "integer"},
            "problems": {"type": "array", "description": "只留 near / miss / empty 项，最多 80 条"}
          }
        },
        "coverage": {
          "type": "object",
          "description": "台词覆盖率，专盯遗漏",
          "properties": {
            "raw_speech_count": {"type": "integer"},
            "extracted_dialogue_count": {"type": "integer"},
            "missed_count": {"type": "integer"},
            "dialogue_coverage": {"type": "number"},
            "missed_samples": {"type": "array", "items": {"type": "string"}}
          }
        },
        "repair_rounds": {"type": "integer", "description": "模型修订轮数累计（--phase review 会在旧值上累加）"},
        "context_chapters_used": {"type": "array", "items": {"type": "integer"}},
        "repaired_by": {"type": "string", "description": "被哪个脚本就地修补过，如 s5_repair_quotes"}
      }
    },

    "reviews": {
      "type": "array",
      "description": "每次模型调用一条留痕。extract_meta 只有用量没有分数；两类审查有 score 与 analysis；repair 只在出错时留一条 error。--phase review 追加在旧记录之后。",
      "items": {
        "type": "object",
        "required": ["stage"],
        "properties": {
          "stage": {"enum": ["extract_meta", "structure_review", "fidelity_review", "repair"]},
          "round": {"type": "integer", "description": "0 = 首轮，n = 第 n 轮修订后的复核"},
          "score": {"type": ["integer", "null"]},
          "verdict": {"enum": ["pass", "revise", "fail", null]},
          "analysis": {"type": "string", "description": "审查详细分析，≥ config.REVIEW_ANALYSIS_MIN_CHARS 字"},
          "issues": {"type": "array"},
          "checked_items": {"type": "object"},
          "missing_items": {"type": "object", "description": "一致性审查员列出的遗漏项。非空即不过闸门"},
          "model": {"type": "string"},
          "tokens": {"type": "object"},
          "attempts": {"type": ["integer", "null"], "description": "这次调用发了几次请求"},
          "adapted": {"type": "array", "items": {"type": "string"},
                      "description": "靠哪些降级才成功（关 JSON 模式 / 关思考 / 加额度）"},
          "error": {"type": "string", "description": "仅 stage=repair 出错时"},
          "reviewed_at": {"type": "string"}
        }
      }
    },

    "run": {
      "type": "object",
      "required": ["pipeline_version", "model", "phase", "llm_calls", "finished_at"],
      "properties": {
        "pipeline_version": {"type": "string"},
        "model": {"type": "string", "description": "模型名；人工稿为「人工」"},
        "phase": {"type": "string", "description": "all / review / manual"},
        "thinking": {"type": ["string", "boolean"], "description": "思考模式：false 或 effort 档位"},
        "llm_calls": {"type": "integer", "minimum": 0, "description": "模型调用累计（人工稿为 0）。与 reviews 条数对得上"},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string", "description": "缺失即视为写到一半被打断，s2 续传时重跑"},
        "elapsed_sec": {"type": "number"}
      }
    }
  }
}
